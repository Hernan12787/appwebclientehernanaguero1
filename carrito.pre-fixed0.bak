<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carrito | Refrescante Argentina</title>
  <link rel="icon" type="image/x-icon" href="refresco.ico">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header>
    <div class="logo"><img src="img/coca-tapa.svg" alt="Tapa de Coca-Cola" class="logo-icono"> Refrescante Argentina</div>
    <nav aria-label="Navegación principal">
      <ul>
        <li><a href="index.html#inicio">Inicio</a></li>
        <li><a href="index.html#catalogo">Catálogo</a></li>
        <li><a href="carrito.html">Carrito</a></li>
        <li><a href="contacto.html">Contacto</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section id="carrito">
      <h2>Tu carrito de compras</h2>
      <p class="carrito-hint">Elegí cuántas unidades querés comprar de cada gaseosa (hasta 9 por producto).</p>

      <div class="carrito-wrap">
        <div class="carrito-grid">

          <article class="item-carrito card-coca">
            <img src="img/coca-cola.jpg" alt="Coca-Cola Original 500ml">
            <div class="item-info">
              <h4>Coca-Cola Original 500ml</h4>
              <p>Precio unitario: $1.900</p>
              <div class="uds uds-coca">
                <input type="checkbox" id="ab-coca" class="ud-toggle">
                <div class="pills" role="radiogroup" aria-label="Unidades de Coca-Cola Original 500ml">
                  <input type="radio" id="q-coca-0" name="uds-coca" checked>
                  <label for="q-coca-0">0</label>
                  <input type="radio" id="q-coca-1" name="uds-coca">
                  <label for="q-coca-1">1</label>
                  <input type="radio" id="q-coca-2" name="uds-coca">
                  <label for="q-coca-2">2</label>
                  <input type="radio" id="q-coca-3" name="uds-coca">
                  <label for="q-coca-3">3</label>
                  <input type="radio" id="q-coca-4" name="uds-coca">
                  <label for="q-coca-4">4</label>
                  <input type="radio" id="q-coca-5" name="uds-coca">
                  <label for="q-coca-5">5</label>
                  <input type="radio" id="q-coca-6" name="uds-coca">
                  <label for="q-coca-6">6</label>
                  <input type="radio" id="q-coca-7" name="uds-coca">
                  <label for="q-coca-7">7</label>
                  <input type="radio" id="q-coca-8" name="uds-coca">
                  <label for="q-coca-8">8</label>
                  <input type="radio" id="q-coca-9" name="uds-coca">
                  <label for="q-coca-9">9</label>
                  <input type="radio" id="q-coca-10" name="uds-coca">
                  <label for="q-coca-10">10</label>
                  <input type="radio" id="q-coca-11" name="uds-coca">
                  <label for="q-coca-11">11</label>
                  <input type="radio" id="q-coca-12" name="uds-coca">
                  <label for="q-coca-12">12</label>
                  <input type="radio" id="q-coca-13" name="uds-coca">
                  <label for="q-coca-13">13</label>
                  <input type="radio" id="q-coca-14" name="uds-coca">
                  <label for="q-coca-14">14</label>
                  <input type="radio" id="q-coca-15" name="uds-coca">
                  <label for="q-coca-15">15</label>
                  <input type="radio" id="q-coca-16" name="uds-coca">
                  <label for="q-coca-16">16</label>
                  <input type="radio" id="q-coca-17" name="uds-coca">
                  <label for="q-coca-17">17</label>
                  <input type="radio" id="q-coca-18" name="uds-coca">
                  <label for="q-coca-18">18</label>
                  <input type="radio" id="q-coca-19" name="uds-coca">
                  <label for="q-coca-19">19</label>
                  <input type="radio" id="q-coca-20" name="uds-coca">
                  <label for="q-coca-20">20</label>
                  <input type="radio" id="q-coca-21" name="uds-coca">
                  <label for="q-coca-21">21</label>
                  <input type="radio" id="q-coca-22" name="uds-coca">
                  <label for="q-coca-22">22</label>
                  <input type="radio" id="q-coca-23" name="uds-coca">
                  <label for="q-coca-23">23</label>
                  <input type="radio" id="q-coca-24" name="uds-coca">
                  <label for="q-coca-24">24</label>
                  <input type="radio" id="q-coca-25" name="uds-coca">
                  <label for="q-coca-25">25</label>
                  <input type="radio" id="q-coca-26" name="uds-coca">
                  <label for="q-coca-26">26</label>
                  <input type="radio" id="q-coca-27" name="uds-coca">
                  <label for="q-coca-27">27</label>
                  <input type="radio" id="q-coca-28" name="uds-coca">
                  <label for="q-coca-28">28</label>
                  <input type="radio" id="q-coca-29" name="uds-coca">
                  <label for="q-coca-29">29</label>
                  <input type="radio" id="q-coca-30" name="uds-coca">
                  <label for="q-coca-30">30</label>
                </div>
                <label for="ab-coca" class="ud-sum">
                  <span class="ud-txt">Unidades:</span>
                  <span class="ud-val"></span>
                  <span class="ud-caret" aria-hidden="true"></span>
                </label>
              </div>
            </div>
          </article>

