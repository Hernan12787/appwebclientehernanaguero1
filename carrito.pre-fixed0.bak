        <aside class="resumen">
          <h3>Tu lista de compra</h3>
          <ul class="lista-seleccion">
            <li id="fila-coca" class="fila-coca"><span class="ico-sel">&#10003;</span><span class="prod-nombre">Coca-Cola Original 500ml</span><span class="subtot"><span class="cant"></span> × $1.900 = <span class="submonto"></span></span></li>
            <li id="fila-sprite" class="fila-sprite"><span class="ico-sel">&#10003;</span><span class="prod-nombre">Sprite Lima-Limón 500ml</span><span class="subtot"><span class="cant"></span> × $1.800 = <span class="submonto"></span></span></li>
            <li id="fila-fanta" class="fila-fanta"><span class="ico-sel">&#10003;</span><span class="prod-nombre">Fanta Naranja 500ml</span><span class="subtot"><span class="cant"></span> × $1.800 = <span class="submonto"></span></span></li>
            <li id="fila-schweppes" class="fila-schweppes"><span class="ico-sel">&#10003;</span><span class="prod-nombre">Schweppes Tónica 500ml</span><span class="subtot"><span class="cant"></span> × $2.000 = <span class="submonto"></span></span></li>
          </ul>
          <p class="res-total">Total a pagar: <strong id="total-compra"></strong></p>
          <input type="checkbox" id="comprado" class="check-finalizar">
          <p class="res-mensaje">
            <span class="msg-ok">Gracias por tu compra. Total: <span class="msg-total"></span>.</span>
            <span class="msg-vacio">Aún no elegiste ninguna gaseosa.</span>
          </p>
          <label for="comprado" class="btn-finalizar">Finalizar compra</label>
        </aside>
      </div>
    </section>

    <section id="tiendas">
      <h3>Tiendas Cencosud</h3>
      <div class="item-cards">
        <article class="tienda">
          <img src="img/jumbo.jpg" alt="Logo Jumbo Cencosud">
          <h4>Jumbo Cencosud</h4>
          <p>Tus compras del súper con toda la chispa Coca‑Cola.</p>
          <a href="https://www.jumbo.com.ar/benedictino?_q=benedictino&map=ft" rel="noopener noreferrer" target="_blank">Comprar acá</a>
        </article>
        <article class="tienda">
          <img src="img/disco.jpg" alt="Logo Disco Cencosud">
          <h4>Disco Cencosud</h4>
          <p>Las mejores ofertas del súper con Coca‑Cola.</p>
          <a href="https://www.disco.com.ar/benedictino?_q=benedictino&map=ft" rel="noopener noreferrer" target="_blank">Comprar acá</a>
        </article>
        <article class="tienda">
          <img src="img/vea.jpg" alt="Logo Vea Cencosud">
          <h4>Vea Cencosud</h4>
          <p>El súper de cercanía con todos tus productos.</p>
          <a href="https://www.vea.com.ar/benedictino?_q=benedictino&map=ft" rel="noopener noreferrer" target="_blank">Comprar acá</a>
        </article>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-logo">
      <img src="img/coca-cola-logo-white.svg" alt="The Coca Cola Company">
    </div>
    <div class="footer-cols">
      <div class="footer-col">
        <h5>Sobre Nosotros</h5>
