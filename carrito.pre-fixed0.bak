                  <label for="q-sprite-28">28</label>
                  <input type="radio" id="q-sprite-29" name="uds-sprite">
                  <label for="q-sprite-29">29</label>
                  <input type="radio" id="q-sprite-30" name="uds-sprite">
                  <label for="q-sprite-30">30</label>
                </div>
                <label for="ab-sprite" class="ud-sum">
                  <span class="ud-txt">Unidades:</span>
