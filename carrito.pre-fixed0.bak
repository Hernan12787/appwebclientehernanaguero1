                  <label for="q-sprite-21">21</label>
                  <input type="radio" id="q-sprite-22" name="uds-sprite">
                  <label for="q-sprite-22">22</label>
                  <input type="radio" id="q-sprite-23" name="uds-sprite">
                  <label for="q-sprite-23">23</label>
