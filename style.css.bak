 /* ===== Reset y base ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #1f2937;
    background-color: #f9fafb;
    line-height: 1.6;
}

main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1rem;
}

img {
    max-width: 100%;
    display: block;
}

a {
    text-decoration: none;
    color: inherit;
}

h2, h3 {
    text-align: center;
    margin: 2.5rem 0 1.5rem;
    color: #111827;
    transition: all 0.3s ease;
}

h3:hover {
    color: #e11d48;
}

/* ===== Header ===== */
header {
    background-color: #ffffff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    padding: 1rem;
    position: sticky;
    top: 0;
    z-index: 10;
}

header .logo {
    font-size: 1.3rem;
    font-weight: 700;
    color: #e11d48;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

header .logo .logo-icono {
    width: 2rem;
    height: 2rem;
    display: inline-block;
}

header nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
}

header nav a {
    padding: 0.4rem 0.2rem;
    font-weight: 500;
    color: #374151;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
}

header nav a:hover {
    color: #e11d48;
    border-bottom-color: #e11d48;
}

/* ===== Historia (vista Inicio) ===== */
.historia {
    text-align: center;
    padding: 2.5rem 1rem 1rem;
}

.historia h1 {
    color: #111827;
    font-size: 2.2rem;
    margin-bottom: 0.75rem;
}

.historia-subtitulo {
    color: #6b7280;
    font-size: 1.1rem;
    max-width: 640px;
    margin: 0 auto 2rem;
}

.historia h2 {
    text-align: center;
    margin: 2.5rem 0 1.5rem;
}

.historia-figura {
    margin: 0;
    text-align: center;
}

.historia-figura img {
    margin: 0 auto 1rem;
    max-height: 150px;
    object-fit: contain;
    border-radius: 0.5rem;
}

.historia-figura figcaption {
    margin-top: 0.25rem;
    color: #9ca3af;
    font-size: 0.85rem;
}

.historia-texto p {
    text-align: center;
}

.historia-texto-ancho {
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
}

.historia-lista {
    max-width: 640px;
    margin: 0 auto;
    padding-left: 1.25rem;
    color: #4b5563;
    text-align: left;
}

.historia-lista li {
    margin-bottom: 0.75rem;
}

.hitos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
}

.hito {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s, box-shadow 0.2s;
}

.hito:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

.hito h4 {
    margin-bottom: 0.5rem;
    color: #111827;
    transition: all 0.3s ease;
}

.hito:hover h4 {
    color: #e11d48;
}

.hito-fecha {
    color: #e11d48;
    font-weight: 700;
    margin-bottom: 0.5rem;
}

.hito p {
    color: #6b7280;
}

/* ===== Grids de tarjetas ===== */


.items .item-cards,
#carrito .item-cards,
#tiendas .item-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
}

.marca,
.producto,
#descubri .experiencia,
.tienda {
   
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s, box-shadow 0.2s;
}

.marca:hover,
.producto:hover,
#descubri .experiencia:hover,
.tienda:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

.marca {
    transition: transform 0.3s ease-in, box-shadow 0.3s ease-in;
}

.producto img,
#descubri .experiencia img {
    margin: 0 auto 1rem;
    border-radius: 0.5rem;
}

.producto img {
    max-height: 150px;
    object-fit: contain;
}

.tienda img {
    width: 100%;
    max-width: 320px;
    height: auto;
    margin: 0 auto 1.25rem;
    border-radius: 0.75rem;
}

.producto h4,
.marca h4,
#descubri .experiencia h4,
.tienda h4 {
    margin-bottom: 0.5rem;
    color: #111827;
    transition: all 0.3s ease;
}

.producto:hover h4,
.marca:hover h4,
#descubri .experiencia:hover h4,
.tienda:hover h4 {
    color: #e11d48;
}

.producto p,
.marca p,
#descubri .experiencia p,
.tienda p {
    color: #6b7280;
    margin-bottom: 1rem;
}

.producto a,
.marca a,
#descubri .experiencia a,
.tienda a {
    display: inline-block;
    font-weight: 600;
    color: #e11d48;
    border: 1px solid #e11d48;
    padding: 0.4rem 1.2rem;
    border-radius: 2rem;
    transition: background 0.2s, color 0.2s;
}

.producto a:hover,
.marca a:hover,
#descubri .experiencia a:hover,
.tienda a:hover {
    background: #e11d48;
    color: #ffffff;
}

/* ===== Historia solo visible en #inicio, oculta en las vistas de catálogo y descubrí ===== */
main#inicio:has(#catalogo:target) .historia,
main#inicio:has(#descubri:target) .historia {
    display: none;
}

/* ===== Vistas por ancla: catálogo y descubrí solo desde su enlace ===== */
main#inicio #catalogo,
main#inicio #descubri {
    display: none;
}

main#inicio #catalogo:target,
main#inicio #descubri:target {
    display: block;
}

main#inicio:has(#descubri:target) #catalogo {
    display: none;
}

/* ===== Experiencias (solo visibles desde #descubri) ===== */
.experiencia {
    display: none;
}

#descubri .experiencia {
    display: block;
}

/* ===== Comprar ===== */
#comprar {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 3rem 1rem;
}

#comprar h3 {
    text-align: center;
}

#comprar a {
    display: inline-block;
    margin-top: 1rem;
    background: #111827;
    color: #ffffff;
    font-weight: 600;
    padding: 0.75rem 2rem;
    border-radius: 2rem;
    transition: background 0.2s;
}

#comprar a:hover {
    background: #e11d48;
}

/* ===== Footer ===== */
footer {
    background: #111827;
    color: #d1d5db;
    text-align: center;
    padding: 2.5rem 1rem 2rem;
    margin-top: 3rem;
}

footer .footer-logo {
    max-width: 180px;
    margin: 0 auto 2rem;
}

footer .footer-cols {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2.5rem;
    margin-bottom: 2rem;
}

footer .footer-col {
    min-width: 200px;
}

footer .footer-col h5 {
    color: #ffffff;
    font-size: 1rem;
    margin-bottom: 0.75rem;
}

footer .footer-col ul {
    list-style: none;
}

footer .footer-col a {
    color: #9ca3af;
    display: inline-block;
    padding: 0.25rem 0;
    transition: color 0.2s;
}

footer .footer-col a:hover {
    color: #ffffff;
}

footer .footer-social {
    margin-bottom: 1.5rem;
}

footer .footer-social ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
}

footer .footer-social a {
    color: #d1d5db;
    transition: color 0.2s;
}

footer .footer-social a:hover {
    color: #ffffff;
}

footer p {
    color: #9ca3af;
}

/* ===== Carrito ===== */
#carrito {
    display: block;
    max-width: 1000px;
    margin: 0 auto;
}

.carrito-hint {
    color: #6b7280;
    margin-bottom: 1.5rem;
    text-align: center;
}

.carrito-wrap {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.5rem;
    align-items: start;
}

.carrito-grid {
    display: grid;
    gap: 1rem;
}

.item-carrito {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
}

.item-carrito:hover {
    transform: translateY(-2px);
}

.item-info {
    flex: 1;
}

.cantidad {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.6rem;
    flex-wrap: wrap;
}

.cantidad label {
    font-size: 0.9rem;
    color: #6b7280;
    font-weight: 600;
}

.item-carrito img {
    max-height: 150px;
    max-width: 150px;
    object-fit: contain;
    border-radius: 0.5rem;
}

.item-carrito h4 {
    color: #111827;
    margin-bottom: 0.25rem;
}

.item-carrito p {
    color: #6b7280;
}

.lista-seleccion {
    list-style: none;
    margin: 0 0 1rem;
    padding-top: 0.5rem;
    border-top: 1px solid #e5e7eb;
}

.lista-seleccion li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0;
    border-bottom: 1px dashed #e5e7eb;
    color: #374151;
    font-size: 0.95rem;
}

.ico-sel {
    color: #e11d48;
    font-weight: 700;
}

.subtot {
    margin-left: auto;
    font-weight: 600;
    color: #111827;
}

.res-total {
    font-size: 0.9rem;
    color: #9ca3af;
}

.resumen {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.resumen h3 {
    text-align: left;
    margin: 0 0 1rem;
    color: #111827;
}

.resumen p {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    color: #6b7280;
}

.resumen p strong {
    color: #111827;
}

.resumen a {
    display: block;
    text-align: center;
    margin-top: 1.25rem;
    background: #e11d48;
    color: #ffffff;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border-radius: 2rem;
    transition: background 0.2s;
}

.resumen a:hover {
    background: #be123c;
}

.resumen .btn-finalizar {
    display: block;
    width: 100%;
    text-align: center;
    margin-top: 1.25rem;
    background: #e11d48;
    color: #ffffff;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 2rem;
    cursor: pointer;
    transition: background 0.2s;
}

.resumen .btn-finalizar:hover {
    background: #be123c;
}

.resumen .res-mensaje {
    display: block;
    min-height: 1.2rem;
}

.res-mensaje {
    font-size: 0.9rem;
    color: #9ca3af;
}

/* ===== Carrito sin JavaScript: calculo con contadores CSS ===== */

/* Los simbolos van separados por espacio (no por coma).
   Cada valor del contador son 100 pesos: 12 = $1.200, 11 = $1.100.
   El maximo posible es 9 x $1.200 + 9 x $1.100 x 3 = $40.500, asi que
   el contador va de 0 a 405 y cada valor ya sale con punto de miles. */
@counter-style pesos {
    system: fixed;
    overflow: clip;
    symbols:
        "0" "100" "200" "300" "400" "500" "600" "700" "800" "900" "1.000" "1.100" 
        "1.200" "1.300" "1.400" "1.500" "1.600" "1.700" "1.800" "1.900" "2.000" "2.100" "2.200" "2.300" 
        "2.400" "2.500" "2.600" "2.700" "2.800" "2.900" "3.000" "3.100" "3.200" "3.300" "3.400" "3.500" 
        "3.600" "3.700" "3.800" "3.900" "4.000" "4.100" "4.200" "4.300" "4.400" "4.500" "4.600" "4.700" 
        "4.800" "4.900" "5.000" "5.100" "5.200" "5.300" "5.400" "5.500" "5.600" "5.700" "5.800" "5.900" 
        "6.000" "6.100" "6.200" "6.300" "6.400" "6.500" "6.600" "6.700" "6.800" "6.900" "7.000" "7.100" 
        "7.200" "7.300" "7.400" "7.500" "7.600" "7.700" "7.800" "7.900" "8.000" "8.100" "8.200" "8.300" 
        "8.400" "8.500" "8.600" "8.700" "8.800" "8.900" "9.000" "9.100" "9.200" "9.300" "9.400" "9.500" 
        "9.600" "9.700" "9.800" "9.900" "10.000" "10.100" "10.200" "10.300" "10.400" "10.500" "10.600" "10.700" 
        "10.800" "10.900" "11.000" "11.100" "11.200" "11.300" "11.400" "11.500" "11.600" "11.700" "11.800" "11.900" 
        "12.000" "12.100" "12.200" "12.300" "12.400" "12.500" "12.600" "12.700" "12.800" "12.900" "13.000" "13.100" 
        "13.200" "13.300" "13.400" "13.500" "13.600" "13.700" "13.800" "13.900" "14.000" "14.100" "14.200" "14.300" 
        "14.400" "14.500" "14.600" "14.700" "14.800" "14.900" "15.000" "15.100" "15.200" "15.300" "15.400" "15.500" 
        "15.600" "15.700" "15.800" "15.900" "16.000" "16.100" "16.200" "16.300" "16.400" "16.500" "16.600" "16.700" 
        "16.800" "16.900" "17.000" "17.100" "17.200" "17.300" "17.400" "17.500" "17.600" "17.700" "17.800" "17.900" 
        "18.000" "18.100" "18.200" "18.300" "18.400" "18.500" "18.600" "18.700" "18.800" "18.900" "19.000" "19.100" 
        "19.200" "19.300" "19.400" "19.500" "19.600" "19.700" "19.800" "19.900" "20.000" "20.100" "20.200" "20.300" 
        "20.400" "20.500" "20.600" "20.700" "20.800" "20.900" "21.000" "21.100" "21.200" "21.300" "21.400" "21.500" 
        "21.600" "21.700" "21.800" "21.900" "22.000" "22.100" "22.200" "22.300" "22.400" "22.500" "22.600" "22.700" 
        "22.800" "22.900" "23.000" "23.100" "23.200" "23.300" "23.400" "23.500" "23.600" "23.700" "23.800" "23.900" 
        "24.000" "24.100" "24.200" "24.300" "24.400" "24.500" "24.600" "24.700" "24.800" "24.900" "25.000" "25.100" 
        "25.200" "25.300" "25.400" "25.500" "25.600" "25.700" "25.800" "25.900" "26.000" "26.100" "26.200" "26.300" 
        "26.400" "26.500" "26.600" "26.700" "26.800" "26.900" "27.000" "27.100" "27.200" "27.300" "27.400" "27.500" 
        "27.600" "27.700" "27.800" "27.900" "28.000" "28.100" "28.200" "28.300" "28.400" "28.500" "28.600" "28.700" 
        "28.800" "28.900" "29.000" "29.100" "29.200" "29.300" "29.400" "29.500" "29.600" "29.700" "29.800" "29.900" 
        "30.000" "30.100" "30.200" "30.300" "30.400" "30.500" "30.600" "30.700" "30.800" "30.900" "31.000" "31.100" 
        "31.200" "31.300" "31.400" "31.500" "31.600" "31.700" "31.800" "31.900" "32.000" "32.100" "32.200" "32.300" 
        "32.400" "32.500" "32.600" "32.700" "32.800" "32.900" "33.000" "33.100" "33.200" "33.300" "33.400" "33.500" 
        "33.600" "33.700" "33.800" "33.900" "34.000" "34.100" "34.200" "34.300" "34.400" "34.500" "34.600" "34.700" 
        "34.800" "34.900" "35.000" "35.100" "35.200" "35.300" "35.400" "35.500" "35.600" "35.700" "35.800" "35.900" 
        "36.000" "36.100" "36.200" "36.300" "36.400" "36.500" "36.600" "36.700" "36.800" "36.900" "37.000" "37.100" 
        "37.200" "37.300" "37.400" "37.500" "37.600" "37.700" "37.800" "37.900" "38.000" "38.100" "38.200" "38.300" 
        "38.400" "38.500" "38.600" "38.700" "38.800" "38.900" "39.000" "39.100" "39.200" "39.300" "39.400" "39.500" 
        "39.600" "39.700" "39.800" "39.900" "40.000" "40.100" "40.200" "40.300" "40.400" "40.500";
}

/* Cada radio marcado suma su subtotal al total general, a la fila que le
   corresponde de la lista y a la cantidad mostrada. */
#q-coca-0:checked { counter-increment: total 0 cant-coca 0 sub-coca 0; }
#q-coca-1:checked { counter-increment: total 12 cant-coca 1 sub-coca 12; }
#q-coca-2:checked { counter-increment: total 24 cant-coca 2 sub-coca 24; }
#q-coca-3:checked { counter-increment: total 36 cant-coca 3 sub-coca 36; }
#q-coca-4:checked { counter-increment: total 48 cant-coca 4 sub-coca 48; }
#q-coca-5:checked { counter-increment: total 60 cant-coca 5 sub-coca 60; }
#q-coca-6:checked { counter-increment: total 72 cant-coca 6 sub-coca 72; }
#q-coca-7:checked { counter-increment: total 84 cant-coca 7 sub-coca 84; }
#q-coca-8:checked { counter-increment: total 96 cant-coca 8 sub-coca 96; }
#q-coca-9:checked { counter-increment: total 108 cant-coca 9 sub-coca 108; }
#q-sprite-0:checked { counter-increment: total 0 cant-sprite 0 sub-sprite 0; }
#q-sprite-1:checked { counter-increment: total 11 cant-sprite 1 sub-sprite 11; }
#q-sprite-2:checked { counter-increment: total 22 cant-sprite 2 sub-sprite 22; }
#q-sprite-3:checked { counter-increment: total 33 cant-sprite 3 sub-sprite 33; }
#q-sprite-4:checked { counter-increment: total 44 cant-sprite 4 sub-sprite 44; }
#q-sprite-5:checked { counter-increment: total 55 cant-sprite 5 sub-sprite 55; }
#q-sprite-6:checked { counter-increment: total 66 cant-sprite 6 sub-sprite 66; }
#q-sprite-7:checked { counter-increment: total 77 cant-sprite 7 sub-sprite 77; }
#q-sprite-8:checked { counter-increment: total 88 cant-sprite 8 sub-sprite 88; }
#q-sprite-9:checked { counter-increment: total 99 cant-sprite 9 sub-sprite 99; }
#q-fanta-0:checked { counter-increment: total 0 cant-fanta 0 sub-fanta 0; }
#q-fanta-1:checked { counter-increment: total 11 cant-fanta 1 sub-fanta 11; }
#q-fanta-2:checked { counter-increment: total 22 cant-fanta 2 sub-fanta 22; }
#q-fanta-3:checked { counter-increment: total 33 cant-fanta 3 sub-fanta 33; }
#q-fanta-4:checked { counter-increment: total 44 cant-fanta 4 sub-fanta 44; }
#q-fanta-5:checked { counter-increment: total 55 cant-fanta 5 sub-fanta 55; }
#q-fanta-6:checked { counter-increment: total 66 cant-fanta 6 sub-fanta 66; }
#q-fanta-7:checked { counter-increment: total 77 cant-fanta 7 sub-fanta 77; }
#q-fanta-8:checked { counter-increment: total 88 cant-fanta 8 sub-fanta 88; }
#q-fanta-9:checked { counter-increment: total 99 cant-fanta 9 sub-fanta 99; }
#q-schweppes-0:checked { counter-increment: total 0 cant-schweppes 0 sub-schweppes 0; }
#q-schweppes-1:checked { counter-increment: total 11 cant-schweppes 1 sub-schweppes 11; }
#q-schweppes-2:checked { counter-increment: total 22 cant-schweppes 2 sub-schweppes 22; }
#q-schweppes-3:checked { counter-increment: total 33 cant-schweppes 3 sub-schweppes 33; }
#q-schweppes-4:checked { counter-increment: total 44 cant-schweppes 4 sub-schweppes 44; }
#q-schweppes-5:checked { counter-increment: total 55 cant-schweppes 5 sub-schweppes 55; }
#q-schweppes-6:checked { counter-increment: total 66 cant-schweppes 6 sub-schweppes 66; }
#q-schweppes-7:checked { counter-increment: total 77 cant-schweppes 7 sub-schweppes 77; }
#q-schweppes-8:checked { counter-increment: total 88 cant-schweppes 8 sub-schweppes 88; }
#q-schweppes-9:checked { counter-increment: total 99 cant-schweppes 9 sub-schweppes 99; }

/* Los contadores se reinician en cada carga de la pagina */
.carrito-wrap {
    counter-reset: total sub-coca sub-sprite sub-fanta sub-schweppes cant-coca cant-sprite cant-fanta cant-schweppes;
}

/* Selector de unidades: radios con apariencia de botones */
.uds {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.uds .cant-lbl {
    font-size: 0.9rem;
    color: #6b7280;
    font-weight: 600;
}

.pills {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 0.2rem;
    flex: 1 1 100%;
    width: 100%;
    min-width: 0;
}

.pills input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    padding: 0;
    opacity: 0;
    pointer-events: none;
}

.pills label {
    min-width: 0;
    padding: 0.35rem 0.2rem;
    border: 2px solid #d1d5db;
    border-radius: 0.5rem;
    background: #f9fafb;
    color: #111827;
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
}

.pills label:hover {
    border-color: #e11d48;
    color: #e11d48;
}

.pills input:checked + label {
    background: #e11d48;
    border-color: #e11d48;
    color: #ffffff;
}

.pills input:focus-visible + label {
    outline: none;
    box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.25);
}

/* Lista de compra: cantidades, subtotales y total leidos de los contadores */
.fila-coca .cant::after {
    content: counter(cant-coca);
}

.fila-sprite .cant::after {
    content: counter(cant-sprite);
}

.fila-fanta .cant::after {
    content: counter(cant-fanta);
}

.fila-schweppes .cant::after {
    content: counter(cant-schweppes);
}

.fila-coca .submonto::after {
    content: "$" counter(sub-coca, pesos);
}

.fila-sprite .submonto::after {
    content: "$" counter(sub-sprite, pesos);
}

.fila-fanta .submonto::after {
    content: "$" counter(sub-fanta, pesos);
}

.fila-schweppes .submonto::after {
    content: "$" counter(sub-schweppes, pesos);
}

#total-compra::after {
    content: "$" counter(total, pesos);
}

/* Boton "Finalizar compra": el checkbox oculto hace de disparador */
.check-finalizar {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    padding: 0;
    opacity: 0;
}

.check-finalizar:focus-visible~.btn-finalizar {
    outline: none;
    box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.35);
}

.res-mensaje .msg-ok,
.res-mensaje .msg-vacio {
    display: none;
}

.check-finalizar:checked ~ .res-mensaje .msg-ok {
    color: #16a34a;
    font-weight: 600;
}

.check-finalizar:checked ~ .res-mensaje .msg-ok .msg-total::after {
    content: "$" counter(total, pesos);
}

/* Mientras los cuatro productos esten en 0 el total es $0 */
#carrito:has(#q-coca-0:checked):has(#q-sprite-0:checked):has(#q-fanta-0:checked):has(#q-schweppes-0:checked) .check-finalizar:checked~.res-mensaje .msg-ok {
    display: none;
}

#carrito:has(#q-coca-0:checked):has(#q-sprite-0:checked):has(#q-fanta-0:checked):has(#q-schweppes-0:checked) .check-finalizar:checked~.res-mensaje .msg-vacio {
    display: inline;
}

#carrito:not(:has(#q-coca-0:checked):has(#q-sprite-0:checked):has(#q-fanta-0:checked):has(#q-schweppes-0:checked)) .check-finalizar:checked~.res-mensaje .msg-ok {
    display: inline;
}

/* ===== Contacto ===== */
#contacto {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
}

.contacto-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 2rem;
    align-items: start;
}

.contacto-mapa {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.contacto-mapa h3 {
    margin: 0 0 0.75rem;
}

.contacto-mapa .contacto-mapa-dir {
    color: #6b7280;
    margin-bottom: 1rem;
}

.contacto-mapa .contacto-mapa-dir strong {
    color: #111827;
}

.contacto-mapa iframe {
    width: 100%;
    height: 280px;
    border: none;
    border-radius: 0.75rem;
    display: block;
}

.contacto-mapa a {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
    color: #e11d48;
    border: 1px solid #e11d48;
    padding: 0.4rem 1.2rem;
    border-radius: 2rem;
    transition: background 0.2s, color 0.2s;
}

.contacto-mapa a:hover {
    background: #e11d48;
    color: #ffffff;
}

#contacto > p {
    color: #6b7280;
    margin-bottom: 1.5rem;
}

#contacto form {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: left;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

#contacto form div {
    margin-bottom: 1rem;
}

#contacto label {
    display: block;
    font-weight: 600;
    color: #111827;
    margin-bottom: 0.35rem;
}

#contacto input,
#contacto select,
#contacto textarea {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    font-family: inherit;
    font-size: 1rem;
    color: #1f2937;
    background: #f9fafb;
    transition: border-color 0.2s, background 0.2s;
}

#contacto input:focus,
#contacto select:focus,
#contacto textarea:focus {
    outline: none;
    border-color: #e11d48;
    background: #ffffff;
}

#contacto textarea {
    resize: vertical;
}

#contacto button {
    width: 100%;
    background: #e11d48;
    color: #ffffff;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 2rem;
    cursor: pointer;
    transition: background 0.2s;
}

#contacto button:hover {
    background: #be123c;
}

/* ===== Detalle de producto ===== */
#detalle {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 1.5rem;
}

#detalle h3 {
    flex-basis: 100%;
    text-align: center;
    margin: 1rem 0 1.5rem;
}

.producto-detalle {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: all 0.3s ease;
    flex: 1 1 240px;
    max-width: 300px;
}

.producto-detalle:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

.producto-detalle img {
    margin: 0 auto 1rem;
    max-width: 120px;
}

.producto-detalle h4 {
    margin-bottom: 0.5rem;
    color: #111827;
    transition: all 0.3s ease;
}

.producto-detalle:hover h4 {
    color: #e11d48;
}

.producto-detalle p {
    color: #6b7280;
    margin-bottom: 1rem;
}

.producto-detalle ul {
    list-style: none;
    text-align: left;
    margin-bottom: 1rem;
    color: #6b7280;
}

.producto-detalle a {
    display: inline-block;
    font-weight: 600;
    color: #e11d48;
    border: 1px solid #e11d48;
    padding: 0.4rem 1.2rem;
    border-radius: 2rem;
    transition: background 0.2s, color 0.2s;
}

.producto-detalle a:hover {
    background: #e11d48;
    color: #ffffff;
}

/* ===== Buscador de productos (solo HTML/CSS) ===== */
.buscador {
    position: relative;
    margin-bottom: 1.5rem;
}

.buscador .filtro {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}

.buscador-barra {
    position: relative;
    max-width: 440px;
    margin: 0 auto 1.5rem;
    background: #ffffff;
    border: 2px solid #e5e7eb;
    border-radius: 2rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: border-color 0.2s, box-shadow 0.2s;
}

.buscador-barra:hover,
.buscador-barra[open] {
    border-color: #e11d48;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

.bus-summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.1rem;
    cursor: pointer;
    list-style: none;
}

.bus-summary::-webkit-details-marker {
    display: none;
}

.bus-icono {
    color: #e11d48;
}

.bus-texto {
    flex: 1;
    color: #6b7280;
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.bus-texto > span {
    display: none;
}

#f-todos:checked ~ .buscador-barra .t-todos,
#f-coca-cola:checked ~ .buscador-barra .t-coca-cola,
#f-sprite:checked ~ .buscador-barra .t-sprite,
#f-fanta:checked ~ .buscador-barra .t-fanta,
#f-schweppes:checked ~ .buscador-barra .t-schweppes {
    display: inline;
}

.bus-flecha {
    color: #9ca3af;
    font-size: 0.75rem;
    transition: transform 0.2s;
}

.buscador-barra[open] .bus-flecha {
    transform: rotate(180deg);
}

.bus-opciones {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%);
    min-width: 280px;
    max-height: 300px;
    overflow-y: auto;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 0.5rem;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    z-index: 5;
}

.bus-opciones label {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: 0.5rem;
    cursor: pointer;
    color: #374151;
    font-weight: 500;
    transition: background 0.15s, color 0.15s;
}

.bus-opciones label:hover {
    background: #fdf2f4;
    color: #e11d48;
}

#f-todos:checked ~ .buscador-barra .bus-opciones label[for="f-todos"],
#f-coca-cola:checked ~ .buscador-barra .bus-opciones label[for="f-coca-cola"],
#f-sprite:checked ~ .buscador-barra .bus-opciones label[for="f-sprite"],
#f-fanta:checked ~ .buscador-barra .bus-opciones label[for="f-fanta"],
#f-schweppes:checked ~ .buscador-barra .bus-opciones label[for="f-schweppes"] {
    background: #fdf2f4;
    color: #e11d48;
    font-weight: 700;
}

#f-todos:checked ~ .buscador-barra .bus-opciones label[for="f-todos"]::before,
#f-coca-cola:checked ~ .buscador-barra .bus-opciones label[for="f-coca-cola"]::before,
#f-sprite:checked ~ .buscador-barra .bus-opciones label[for="f-sprite"]::before,
#f-fanta:checked ~ .buscador-barra .bus-opciones label[for="f-fanta"]::before,
#f-schweppes:checked ~ .buscador-barra .bus-opciones label[for="f-schweppes"]::before {
    content: "✓ ";
}

/* Filtrado de marcas y productos */
.buscador > section h3 {
    margin-top: 1.5rem;
}

.buscador .item-cards .marca,
.buscador .item-cards .producto {
    display: none;
}

#f-todos:checked ~ #marcas .item-cards .marca,
#f-todos:checked ~ #catalogo .item-cards .producto,
#f-coca-cola:checked ~ #marcas .item-cards .marca-coca-cola,
#f-coca-cola:checked ~ #catalogo .item-cards .producto-coca-cola,
#f-sprite:checked ~ #marcas .item-cards .marca-sprite,
#f-sprite:checked ~ #catalogo .item-cards .producto-sprite,
#f-fanta:checked ~ #marcas .item-cards .marca-fanta,
#f-fanta:checked ~ #catalogo .item-cards .producto-fanta,
#f-schweppes:checked ~ #marcas .item-cards .marca-schweppes,
#f-schweppes:checked ~ #catalogo .item-cards .producto-schweppes {
    display: block;
    animation: aparecer 0.25s ease;
}

#f-coca-cola:checked ~ #marcas .item-cards,
#f-coca-cola:checked ~ #catalogo .item-cards,
#f-sprite:checked ~ #marcas .item-cards,
#f-sprite:checked ~ #catalogo .item-cards,
#f-fanta:checked ~ #marcas .item-cards,
#f-fanta:checked ~ #catalogo .item-cards,
#f-schweppes:checked ~ #marcas .item-cards,
#f-schweppes:checked ~ #catalogo .item-cards {
    grid-template-columns: repeat(auto-fit, minmax(220px, 280px));
    justify-content: center;
}

@keyframes aparecer {
    from {
        opacity: 0;
        transform: translateY(6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ===== Responsive ===== */
/* Todas las media queries van al final: si una regla base aparece despues
   del bloque responsive, la cascada la pisa y el breakpoint deja de funcionar */

@media (max-width: 900px) {
    /* En pantallas angostas el carrito deja de ser de dos columnas */
    .carrito-wrap {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    .hitos-grid,
    .items .item-cards,
    #carrito .item-cards,
    #tiendas .item-cards,
    #catalogo .aguas-detalles .item-cards {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    }
}

@media (max-width: 600px) {
    .historia h1 {
        font-size: 1.6rem;
    }

    header {
        padding: 0.75rem 1rem;
    }

    header nav ul {
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }

    .contacto-grid {
        grid-template-columns: 1fr;
    }

    .bus-opciones {
        left: 0;
        right: 0;
        transform: none;
        min-width: auto;
    }

    /* La tarjeta del producto pasa a columna para que las pastillas
       tengan todo el ancho disponible */
    .item-carrito {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .item-carrito img {
        max-width: 7rem;
        max-height: 7rem;
    }

    .item-info {
        width: 100%;
    }

    .uds {
        justify-content: center;
    }

    .lista-seleccion li {
        flex-wrap: wrap;
    }

    .lista-seleccion li .prod-nombre {
        min-width: 0;
    }

    .ico-sel,
    .subtot {
        flex-shrink: 0;
    }

    .resumen {
        padding: 1.25rem 1rem;
    }
}

@media (max-width: 480px) {
    /* Con menos ancho los 10 botones pasan a 5 por fila */
    .pills {
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.25rem;
    }
}

@media (max-width: 380px) {
    .pills label {
        padding: 0.3rem 0.1rem;
        font-size: 0.85rem;
    }

    footer .footer-col {
        min-width: 0;
    }
}

/* ===== Aguas purificadas y minerales ===== */
#catalogo .aguas-detalles {
    margin-top: 2rem;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

#catalogo .aguas-detalles summary {
    cursor: pointer;
    font-weight: 700;
    color: #111827;
    padding: 1rem 1.25rem;
    list-style-position: inside;
    transition: color 0.2s;
}

#catalogo .aguas-detalles summary:hover {
    color: #e11d48;
}

#catalogo .aguas-detalles[open] summary {
    border-bottom: 1px solid #e5e7eb;
}

#catalogo .aguas-detalles .item-cards {
    padding: 1.5rem;
}

#catalogo .aguas-detalles .agua {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s, box-shadow 0.2s;
}

#catalogo .aguas-detalles .agua a {
    display: block;
    color: inherit;
}

#catalogo .aguas-detalles .agua:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

#catalogo .aguas-detalles .agua img {
    max-height: 150px;
    margin: 0 auto 1rem;
    border-radius: 0.5rem;
    object-fit: contain;
}

#catalogo .aguas-detalles .agua h4 {
    margin-bottom: 0.5rem;
    color: #111827;
    transition: all 0.3s ease;
}

#catalogo .aguas-detalles .agua:hover h4 {
    color: #e11d48;
}
