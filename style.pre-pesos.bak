/* Los contadores se reinician en cada carga de la pagina */
.carrito-wrap {
    counter-reset: total sub-coca sub-sprite sub-fanta sub-schweppes cant-coca cant-sprite cant-fanta cant-schweppes;
}

/* ===== Selector de unidades: chip con la cantidad + panel desplegable ===== */

/* La cantidad elegida se ve en el chip (sin abrir nada) y se cambia desde el panel.
   El panel arranca cerrado, pero los radios nunca se ocultan con display: none
   porque los elementos con display: none no suman a los contadores CSS.
   column-reverse: en el DOM el chip va despues de los radios (asi el contador ya
   esta sumado) pero visualmente sigue arriba del panel. */
.uds {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-start;
    margin-top: 0.6rem;
}

.ud-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    padding: 0;
    opacity: 0;
}

.ud-sum {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    border: 2px solid #d1d5db;
    border-radius: 2rem;
    background: #ffffff;
    color: #111827;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, box-shadow 0.2s;
}

.ud-sum:hover {
    border-color: #e11d48;
    color: #e11d48;
}

.ud-toggle:focus-visible~.ud-sum {
    box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.25);
}

.ud-toggle:checked~.ud-sum {
    border-color: #e11d48;
    color: #e11d48;
}

.ud-txt {
    color: #6b7280;
}

/* La cantidad actual, leida del contador */
.ud-val {
    min-width: 1.4rem;
    padding: 0 0.35rem;
    border-radius: 1rem;
    background: #e11d48;
    color: #ffffff;
    font-weight: 700;
    text-align: center;
}

.uds-coca .ud-val::after {
    content: counter(cant-coca);
}

.uds-sprite .ud-val::after {
    content: counter(cant-sprite);
}

.uds-fanta .ud-val::after {
    content: counter(cant-fanta);
}

.uds-schweppes .ud-val::after {
    content: counter(cant-schweppes);
}

.ud-caret {
    display: inline-block;
    transition: transform 0.2s;
}

.ud-caret::after {
    content: "\25BE";
    font-size: 0.75rem;
}

.ud-toggle:checked~.ud-sum .ud-caret {
    transform: rotate(180deg);
}

.pills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(2.2rem, 1fr));
    gap: 0.2rem;
    width: 100%;
    margin-top: 0.6rem;
    max-height: 20rem;
    overflow: hidden;
    transition: max-height 0.25s ease, margin-top 0.25s ease, opacity 0.2s ease;
}

.ud-toggle:not(:checked)~.pills {
    max-height: 0;
    margin-top: 0;
    opacity: 0;
}

/* visibility: hidden saca el radio del recorrido del teclado
   pero lo deja contabilizando, a diferencia de display: none */
.ud-toggle:not(:checked)~.pills input {
    visibility: hidden;
}

.pills input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    padding: 0;
    opacity: 0;
    pointer-events: none;
}

.pills label {
    min-width: 0;
    padding: 0.35rem 0.2rem;
    border: 2px solid #d1d5db;
    border-radius: 0.5rem;
    background: #f9fafb;
    color: #111827;
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
}

.pills label:hover {
    border-color: #e11d48;
    color: #e11d48;
}

.pills input:checked+label {
    background: #e11d48;
    border-color: #e11d48;
    color: #ffffff;
}

.pills input:focus-visible+label {
    outline: none;
    box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.25);
}

/* Lista de compra: cantidades, subtotales y total leidos de los contadores */
.fila-coca .cant::after {
    content: counter(cant-coca);
}

.fila-sprite .cant::after {
    content: counter(cant-sprite);
}

.fila-fanta .cant::after {
    content: counter(cant-fanta);
}

.fila-schweppes .cant::after {
    content: counter(cant-schweppes);
}

.fila-coca .submonto::after {
    content: "$" counter(sub-coca, pesos);
}

.fila-sprite .submonto::after {
    content: "$" counter(sub-sprite, pesos);
}

.fila-fanta .submonto::after {
    content: "$" counter(sub-fanta, pesos);
}

.fila-schweppes .submonto::after {
    content: "$" counter(sub-schweppes, pesos);
}

#total-compra::after {
    content: "$" counter(total, pesos);
}

/* Boton "Finalizar compra": el checkbox oculto hace de disparador */
.check-finalizar {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    padding: 0;
    opacity: 0;
}

.check-finalizar:focus-visible~.btn-finalizar {
    outline: none;
    box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.35);
}

.res-mensaje .msg-ok,
.res-mensaje .msg-vacio {
    display: none;
}

.check-finalizar:checked ~ .res-mensaje .msg-ok {
    color: #16a34a;
    font-weight: 600;
}

.check-finalizar:checked ~ .res-mensaje .msg-ok .msg-total::after {
    content: "$" counter(total, pesos);
}

/* Mientras los cuatro productos esten en 0 el total es $0 */
#carrito:has(#q-coca-0:checked):has(#q-sprite-0:checked):has(#q-fanta-0:checked):has(#q-schweppes-0:checked) .check-finalizar:checked~.res-mensaje .msg-ok {
    display: none;
}

#carrito:has(#q-coca-0:checked):has(#q-sprite-0:checked):has(#q-fanta-0:checked):has(#q-schweppes-0:checked) .check-finalizar:checked~.res-mensaje .msg-vacio {
    display: inline;
}

#carrito:not(:has(#q-coca-0:checked):has(#q-sprite-0:checked):has(#q-fanta-0:checked):has(#q-schweppes-0:checked)) .check-finalizar:checked~.res-mensaje .msg-ok {
    display: inline;
}

/* ===== Contacto ===== */
#contacto {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
}

.contacto-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 2rem;
    align-items: start;
}

.contacto-mapa {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.contacto-mapa h3 {
    margin: 0 0 0.75rem;
}

.contacto-mapa .contacto-mapa-dir {
    color: #6b7280;
    margin-bottom: 1rem;
}

.contacto-mapa .contacto-mapa-dir strong {
    color: #111827;
}

.contacto-mapa iframe {
    width: 100%;
    height: 280px;
    border: none;
    border-radius: 0.75rem;
    display: block;
}

.contacto-mapa a {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
    color: #e11d48;
    border: 1px solid #e11d48;
    padding: 0.4rem 1.2rem;
    border-radius: 2rem;
    transition: background 0.2s, color 0.2s;
}

.contacto-mapa a:hover {
    background: #e11d48;
    color: #ffffff;
}

#contacto > p {
    color: #6b7280;
    margin-bottom: 1.5rem;
}

#contacto form {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: left;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

#contacto form div {
    margin-bottom: 1rem;
}

#contacto label {
    display: block;
    font-weight: 600;
    color: #111827;
    margin-bottom: 0.35rem;
}

#contacto input,
#contacto select,
#contacto textarea {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    font-family: inherit;
    font-size: 1rem;
    color: #1f2937;
    background: #f9fafb;
    transition: border-color 0.2s, background 0.2s;
}

#contacto input:focus,
#contacto select:focus,
#contacto textarea:focus {
    outline: none;
    border-color: #e11d48;
    background: #ffffff;
}

#contacto textarea {
    resize: vertical;
}

#contacto button {
    width: 100%;
    background: #e11d48;
    color: #ffffff;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 2rem;
    cursor: pointer;
    transition: background 0.2s;
}

#contacto button:hover {
    background: #be123c;
}

/* ===== Detalle de producto ===== */
#detalle {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 1.5rem;
}

#detalle h3 {
    flex-basis: 100%;
    text-align: center;
    margin: 1rem 0 1.5rem;
}

.producto-detalle {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: all 0.3s ease;
    flex: 1 1 240px;
    max-width: 300px;
}

.producto-detalle:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

.producto-detalle img {
    margin: 0 auto 1rem;
    max-width: 120px;
}

.producto-detalle h4 {
    margin-bottom: 0.5rem;
    color: #111827;
    transition: all 0.3s ease;
}

.producto-detalle:hover h4 {
    color: #e11d48;
}

.producto-detalle p {
    color: #6b7280;
    margin-bottom: 1rem;
}

.producto-detalle ul {
    list-style: none;
    text-align: left;
    margin-bottom: 1rem;
    color: #6b7280;
}

.producto-detalle a {
    display: inline-block;
    font-weight: 600;
    color: #e11d48;
    border: 1px solid #e11d48;
    padding: 0.4rem 1.2rem;
    border-radius: 2rem;
    transition: background 0.2s, color 0.2s;
}

.producto-detalle a:hover {
    background: #e11d48;
    color: #ffffff;
}

/* ===== Buscador de productos (solo HTML/CSS) ===== */
.buscador {
    position: relative;
    margin-bottom: 1.5rem;
}

.buscador .filtro {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}

.buscador-barra {
    position: relative;
    max-width: 440px;
    margin: 0 auto 1.5rem;
    background: #ffffff;
    border: 2px solid #e5e7eb;
    border-radius: 2rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: border-color 0.2s, box-shadow 0.2s;
}

.buscador-barra:hover,
.buscador-barra[open] {
    border-color: #e11d48;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

.bus-summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.1rem;
    cursor: pointer;
    list-style: none;
}

.bus-summary::-webkit-details-marker {
    display: none;
}

.bus-icono {
    color: #e11d48;
}

.bus-texto {
    flex: 1;
    color: #6b7280;
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.bus-texto > span {
    display: none;
}

#f-todos:checked ~ .buscador-barra .t-todos,
#f-coca-cola:checked ~ .buscador-barra .t-coca-cola,
#f-sprite:checked ~ .buscador-barra .t-sprite,
#f-fanta:checked ~ .buscador-barra .t-fanta,
#f-schweppes:checked ~ .buscador-barra .t-schweppes {
    display: inline;
}

.bus-flecha {
    color: #9ca3af;
    font-size: 0.75rem;
    transition: transform 0.2s;
}

.buscador-barra[open] .bus-flecha {
    transform: rotate(180deg);
}

.bus-opciones {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%);
    min-width: 280px;
    max-height: 300px;
    overflow-y: auto;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 0.5rem;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    z-index: 5;
}

.bus-opciones label {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: 0.5rem;
    cursor: pointer;
    color: #374151;
    font-weight: 500;
    transition: background 0.15s, color 0.15s;
}

.bus-opciones label:hover {
    background: #fdf2f4;
    color: #e11d48;
}

#f-todos:checked ~ .buscador-barra .bus-opciones label[for="f-todos"],
#f-coca-cola:checked ~ .buscador-barra .bus-opciones label[for="f-coca-cola"],
#f-sprite:checked ~ .buscador-barra .bus-opciones label[for="f-sprite"],
#f-fanta:checked ~ .buscador-barra .bus-opciones label[for="f-fanta"],
#f-schweppes:checked ~ .buscador-barra .bus-opciones label[for="f-schweppes"] {
    background: #fdf2f4;
    color: #e11d48;
    font-weight: 700;
}

#f-todos:checked ~ .buscador-barra .bus-opciones label[for="f-todos"]::before,
#f-coca-cola:checked ~ .buscador-barra .bus-opciones label[for="f-coca-cola"]::before,
#f-sprite:checked ~ .buscador-barra .bus-opciones label[for="f-sprite"]::before,
#f-fanta:checked ~ .buscador-barra .bus-opciones label[for="f-fanta"]::before,
#f-schweppes:checked ~ .buscador-barra .bus-opciones label[for="f-schweppes"]::before {
    content: "✓ ";
}

/* Filtrado de marcas y productos */
.buscador > section h3 {
    margin-top: 1.5rem;
}

.buscador .item-cards .marca,
.buscador .item-cards .producto {
    display: none;
}

#f-todos:checked ~ #marcas .item-cards .marca,
#f-todos:checked ~ #catalogo .item-cards .producto,
#f-coca-cola:checked ~ #marcas .item-cards .marca-coca-cola,
#f-coca-cola:checked ~ #catalogo .item-cards .producto-coca-cola,
#f-sprite:checked ~ #marcas .item-cards .marca-sprite,
#f-sprite:checked ~ #catalogo .item-cards .producto-sprite,
#f-fanta:checked ~ #marcas .item-cards .marca-fanta,
#f-fanta:checked ~ #catalogo .item-cards .producto-fanta,
#f-schweppes:checked ~ #marcas .item-cards .marca-schweppes,
#f-schweppes:checked ~ #catalogo .item-cards .producto-schweppes {
    display: block;
    animation: aparecer 0.25s ease;
}

#f-coca-cola:checked ~ #marcas .item-cards,
#f-coca-cola:checked ~ #catalogo .item-cards,
#f-sprite:checked ~ #marcas .item-cards,
#f-sprite:checked ~ #catalogo .item-cards,
#f-fanta:checked ~ #marcas .item-cards,
#f-fanta:checked ~ #catalogo .item-cards,
#f-schweppes:checked ~ #marcas .item-cards,
#f-schweppes:checked ~ #catalogo .item-cards {
    grid-template-columns: repeat(auto-fit, minmax(220px, 280px));
    justify-content: center;
}

@keyframes aparecer {
    from {
        opacity: 0;
        transform: translateY(6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ===== Responsive ===== */
/* Todas las media queries van al final: si una regla base aparece despues
   del bloque responsive, la cascada la pisa y el breakpoint deja de funcionar */

@media (max-width: 900px) {
    /* En pantallas angostas el carrito deja de ser de dos columnas */
    .carrito-wrap {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    .hitos-grid,
    .items .item-cards,
    #carrito .item-cards,
    #tiendas .item-cards,
    #catalogo .aguas-detalles .item-cards {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    }
}

@media (max-width: 600px) {
    .historia h1 {
        font-size: 1.6rem;
    }

    header {
        padding: 0.75rem 1rem;
    }

    header nav ul {
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }

    .contacto-grid {
        grid-template-columns: 1fr;
    }

    .bus-opciones {
        left: 0;
        right: 0;
        transform: none;
        min-width: auto;
    }

    /* La tarjeta del producto pasa a columna para que las pastillas
       tengan todo el ancho disponible */
    .item-carrito {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .item-carrito img {
        max-width: 7rem;
        max-height: 7rem;
    }

    .item-info {
        width: 100%;
    }

    .uds {
        margin-top: 0.5rem;
    }

    .lista-seleccion li {
        flex-wrap: wrap;
    }

    .lista-seleccion li .prod-nombre {
        min-width: 0;
    }

    .ico-sel,
    .subtot {
        flex-shrink: 0;
    }

    .resumen {
        padding: 1.25rem 1rem;
    }
}

@media (max-width: 480px) {
    /* Con menos ancho las pastillas pasan a 5 por fila */
    .pills {
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.25rem;
    }

    .ud-sum {
        padding: 0.35rem 0.6rem;
    }
}

@media (max-width: 380px) {
    .pills label {
        padding: 0.3rem 0.1rem;
        font-size: 0.85rem;
    }

    footer .footer-col {
        min-width: 0;
    }
}

/* ===== Aguas purificadas y minerales ===== */
#catalogo .aguas-detalles {
    margin-top: 2rem;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

#catalogo .aguas-detalles summary {
    cursor: pointer;
    font-weight: 700;
    color: #111827;
    padding: 1rem 1.25rem;
    list-style-position: inside;
    transition: color 0.2s;
}

#catalogo .aguas-detalles summary:hover {
    color: #e11d48;
}

#catalogo .aguas-detalles[open] summary {
    border-bottom: 1px solid #e5e7eb;
}

#catalogo .aguas-detalles .item-cards {
    padding: 1.5rem;
}

#catalogo .aguas-detalles .agua {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s, box-shadow 0.2s;
}

#catalogo .aguas-detalles .agua a {
    display: block;
    color: inherit;
}

#catalogo .aguas-detalles .agua:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

#catalogo .aguas-detalles .agua img {
    max-height: 150px;
    margin: 0 auto 1rem;
    border-radius: 0.5rem;
    object-fit: contain;
}

#catalogo .aguas-detalles .agua h4 {
    margin-bottom: 0.5rem;
    color: #111827;
    transition: all 0.3s ease;
}

#catalogo .aguas-detalles .agua:hover h4 {
    color: #e11d48;
}
