 /* ===== Reset y base ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #1f2937;
    background-color: #f9fafb;
    line-height: 1.6;
}

main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1rem;
}

img {
    max-width: 100%;
    display: block;
}

a {
    text-decoration: none;
    color: inherit;
}

h2, h3 {
    text-align: center;
    margin: 2.5rem 0 1.5rem;
    color: #111827;
    transition: all 0.3s ease;
}

h3:hover {
    color: #e11d48;
}

/* ===== Header ===== */
header {
    background-color: #ffffff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    padding: 1rem;
    position: sticky;
    top: 0;
    z-index: 10;
}

header .logo {
    font-size: 1.3rem;
    font-weight: 700;
    color: #e11d48;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

header .logo .logo-icono {
    width: 2rem;
    height: 2rem;
    display: inline-block;
}

header nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
}

header nav a {
    padding: 0.4rem 0.2rem;
    font-weight: 500;
    color: #374151;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
}

header nav a:hover {
    color: #e11d48;
    border-bottom-color: #e11d48;
}

/* ===== Historia (vista Inicio) ===== */
.historia {
    text-align: center;
    padding: 2.5rem 1rem 1rem;
}

.historia h1 {
    color: #111827;
    font-size: 2.2rem;
    margin-bottom: 0.75rem;
}

.historia-subtitulo {
    color: #6b7280;
    font-size: 1.1rem;
    max-width: 640px;
    margin: 0 auto 2rem;
}

.historia h2 {
    text-align: center;
    margin: 2.5rem 0 1.5rem;
}

.historia-figura {
    margin: 0;
    text-align: center;
}

.historia-figura img {
    margin: 0 auto 1rem;
    max-height: 150px;
    object-fit: contain;
    border-radius: 0.5rem;
}

.historia-figura figcaption {
    margin-top: 0.25rem;
    color: #9ca3af;
    font-size: 0.85rem;
}

.historia-texto p {
    text-align: center;
}

.historia-texto-ancho {
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
}

.historia-lista {
    max-width: 640px;
    margin: 0 auto;
    padding-left: 1.25rem;
    color: #4b5563;
    text-align: left;
}

.historia-lista li {
    margin-bottom: 0.75rem;
}

.hitos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
}

.hito {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s, box-shadow 0.2s;
}

.hito:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

.hito h4 {
    margin-bottom: 0.5rem;
    color: #111827;
    transition: all 0.3s ease;
}

.hito:hover h4 {
    color: #e11d48;
}

.hito-fecha {
    color: #e11d48;
    font-weight: 700;
    margin-bottom: 0.5rem;
}

.hito p {
    color: #6b7280;
}

/* ===== Grids de tarjetas ===== */


.items .item-cards,
#carrito .item-cards,
#tiendas .item-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
}

.marca,
.producto,
#descubri .experiencia,
.tienda {
   
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s, box-shadow 0.2s;
}

.marca:hover,
.producto:hover,
#descubri .experiencia:hover,
.tienda:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

.marca {
    transition: transform 0.3s ease-in, box-shadow 0.3s ease-in;
}

.producto img,
#descubri .experiencia img {
    margin: 0 auto 1rem;
    border-radius: 0.5rem;
}

.producto img {
    max-height: 150px;
    object-fit: contain;
}

.tienda img {
    width: 100%;
    max-width: 320px;
    height: auto;
    margin: 0 auto 1.25rem;
    border-radius: 0.75rem;
}

.producto h4,
.marca h4,
#descubri .experiencia h4,
.tienda h4 {
    margin-bottom: 0.5rem;
    color: #111827;
    transition: all 0.3s ease;
}

.producto:hover h4,
.marca:hover h4,
#descubri .experiencia:hover h4,
.tienda:hover h4 {
    color: #e11d48;
}

.producto p,
.marca p,
#descubri .experiencia p,
.tienda p {
    color: #6b7280;
    margin-bottom: 1rem;
}

.producto a,
.marca a,
#descubri .experiencia a,
.tienda a {
    display: inline-block;
    font-weight: 600;
    color: #e11d48;
    border: 1px solid #e11d48;
    padding: 0.4rem 1.2rem;
    border-radius: 2rem;
    transition: background 0.2s, color 0.2s;
}

.producto a:hover,
.marca a:hover,
#descubri .experiencia a:hover,
.tienda a:hover {
    background: #e11d48;
    color: #ffffff;
}

/* ===== Historia solo visible en #inicio, oculta en las vistas de catálogo y descubrí ===== */
main#inicio:has(#catalogo:target) .historia,
main#inicio:has(#descubri:target) .historia {
    display: none;
}

/* ===== Vistas por ancla: catálogo y descubrí solo desde su enlace ===== */
main#inicio #catalogo,
main#inicio #descubri {
    display: none;
}

main#inicio #catalogo:target,
main#inicio #descubri:target {
    display: block;
}

main#inicio:has(#descubri:target) #catalogo {
    display: none;
}

/* ===== Experiencias (solo visibles desde #descubri) ===== */
.experiencia {
    display: none;
}

#descubri .experiencia {
    display: block;
}

/* ===== Comprar ===== */
#comprar {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 3rem 1rem;
}

#comprar h3 {
    text-align: center;
}

#comprar a {
    display: inline-block;
    margin-top: 1rem;
    background: #111827;
    color: #ffffff;
    font-weight: 600;
    padding: 0.75rem 2rem;
    border-radius: 2rem;
    transition: background 0.2s;
}

#comprar a:hover {
    background: #e11d48;
}

/* ===== Footer ===== */
footer {
    background: #111827;
    color: #d1d5db;
    text-align: center;
    padding: 2.5rem 1rem 2rem;
    margin-top: 3rem;
}

footer .footer-logo {
    max-width: 180px;
    margin: 0 auto 2rem;
}

footer .footer-cols {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2.5rem;
    margin-bottom: 2rem;
}

footer .footer-col {
    min-width: 200px;
}

footer .footer-col h5 {
    color: #ffffff;
    font-size: 1rem;
    margin-bottom: 0.75rem;
}

footer .footer-col ul {
    list-style: none;
}

footer .footer-col a {
    color: #9ca3af;
    display: inline-block;
    padding: 0.25rem 0;
    transition: color 0.2s;
}

footer .footer-col a:hover {
    color: #ffffff;
}

footer .footer-social {
    margin-bottom: 1.5rem;
}

footer .footer-social ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
}

footer .footer-social a {
    color: #d1d5db;
    transition: color 0.2s;
}

footer .footer-social a:hover {
    color: #ffffff;
}

footer p {
    color: #9ca3af;
}

/* ===== Carrito ===== */
#carrito {
    display: block;
    max-width: 1000px;
    margin: 0 auto;
}

.carrito-hint {
    color: #6b7280;
    margin-bottom: 1.5rem;
    text-align: center;
}

.carrito-wrap {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.5rem;
    align-items: start;
}

.carrito-grid {
    display: grid;
    gap: 1rem;
}

.item-carrito {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
}

.item-carrito:hover {
    transform: translateY(-2px);
}

.item-info {
    flex: 1;
}

.cantidad {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.6rem;
    flex-wrap: wrap;
}

.cantidad label {
    font-size: 0.9rem;
    color: #6b7280;
    font-weight: 600;
}

.item-carrito img {
    max-height: 150px;
    max-width: 150px;
    object-fit: contain;
    border-radius: 0.5rem;
}

.item-carrito h4 {
    color: #111827;
    margin-bottom: 0.25rem;
}

.item-carrito p {
    color: #6b7280;
}

.lista-seleccion {
    list-style: none;
    margin: 0 0 1rem;
    padding-top: 0.5rem;
    border-top: 1px solid #e5e7eb;
}

.lista-seleccion li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0;
    border-bottom: 1px dashed #e5e7eb;
    color: #374151;
    font-size: 0.95rem;
}

.ico-sel {
    color: #e11d48;
    font-weight: 700;
}

.subtot {
    margin-left: auto;
    font-weight: 600;
    color: #111827;
}

.res-total {
    font-size: 0.9rem;
    color: #9ca3af;
}

.resumen {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.resumen h3 {
    text-align: left;
    margin: 0 0 1rem;
    color: #111827;
}

.resumen p {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    color: #6b7280;
}

.resumen p strong {
    color: #111827;
}

.resumen a {
    display: block;
    text-align: center;
    margin-top: 1.25rem;
    background: #e11d48;
    color: #ffffff;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border-radius: 2rem;
    transition: background 0.2s;
}

.resumen a:hover {
    background: #be123c;
}

.resumen .btn-finalizar {
    display: block;
    width: 100%;
    text-align: center;
    margin-top: 1.25rem;
    background: #e11d48;
    color: #ffffff;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 2rem;
    cursor: pointer;
    transition: background 0.2s;
}

.resumen .btn-finalizar:hover {
    background: #be123c;
}

.resumen .res-mensaje {
    display: block;
    min-height: 1.2rem;
}

.res-mensaje {
    font-size: 0.9rem;
    color: #9ca3af;
}

/* ===== Carrito sin JavaScript: calculo con contadores CSS ===== */

/* Los simbolos van separados por espacio (no por coma).
   Cada valor del contador son 100 pesos: 19 = $1.900, 18 = $1.800.
   Con hasta 30 unidades por producto el total llega a $225.000,
   asi que el contador va de 0 a 2250 y cada valor ya sale con punto de miles. */
@counter-style pesos {
    system: fixed;
    overflow: clip;
    symbols:
        "0" "100" "200" "300" "400" "500" "600" "700" "800" "900" "1.000" "1.100" "1.200" "1.300" "1.400" "1.500" "1.600" "1.700" "1.800" "1.900" "2.000" "2.100" "2.200" "2.300" "2.400" "2.500" "2.600" "2.700" "2.800" "2.900" "3.000" "3.100" "3.200" "3.300" "3.400" "3.500" "3.600" "3.700" "3.800" "3.900" "4.000" "4.100" "4.200" "4.300" "4.400" "4.500" "4.600" "4.700" "4.800" "4.900" "5.000" "5.100" "5.200" "5.300" "5.400" "5.500" "5.600" "5.700" "5.800" "5.900" "6.000" "6.100" "6.200" "6.300" "6.400" "6.500" "6.600" "6.700" "6.800" "6.900" "7.000" "7.100" "7.200" "7.300" "7.400" "7.500" "7.600" "7.700" "7.800" "7.900" "8.000" "8.100" "8.200" "8.300" "8.400" "8.500" "8.600" "8.700" "8.800" "8.900" "9.000" "9.100" "9.200" "9.300" "9.400" "9.500" "9.600" "9.700" "9.800" "9.900" "10.000" "10.100" "10.200" "10.300" "10.400" "10.500" "10.600" "10.700" "10.800" "10.900" "11.000" "11.100" "11.200" "11.300" "11.400" "11.500" "11.600" "11.700" "11.800" "11.900" "12.000" "12.100" "12.200" "12.300" "12.400" "12.500" "12.600" "12.700" "12.800" "12.900" "13.000" "13.100" "13.200" "13.300" "13.400" "13.500" "13.600" "13.700" "13.800" "13.900" "14.000" "14.100" "14.200" "14.300" "14.400" "14.500" "14.600" "14.700" "14.800" "14.900" "15.000" "15.100" "15.200" "15.300" "15.400" "15.500" "15.600" "15.700" "15.800" "15.900" "16.000" "16.100" "16.200" "16.300" "16.400" "16.500" "16.600" "16.700" "16.800" "16.900" "17.000" "17.100" "17.200" "17.300" "17.400" "17.500" "17.600" "17.700" "17.800" "17.900" "18.000" "18.100" "18.200" "18.300" "18.400" "18.500" "18.600" "18.700" "18.800" "18.900" "19.000" "19.100" "19.200" "19.300" "19.400" "19.500" "19.600" "19.700" "19.800" "19.900" "20.000" "20.100" "20.200" "20.300" "20.400" "20.500" "20.600" "20.700" "20.800" "20.900" "21.000" "21.100" "21.200" "21.300" "21.400" "21.500" "21.600" "21.700" "21.800" "21.900" "22.000" "22.100" "22.200" "22.300" "22.400" "22.500" "22.600" "22.700" "22.800" "22.900" "23.000" "23.100" "23.200" "23.300" "23.400"